#!/usr/bin/env bash
#MISE description="Подтянуть каждый клон в repos/ без перезаписи локальных правок"
set -euo pipefail

# Клон с локальными правками пропускается с предупреждением, остальные
# обновляются fast-forward. Rebase и autostash здесь не нужны, mise их не делает.
mise bootstrap repos update --skip-dirty --yes
