#!/usr/bin/env bash
#MISE description="Поставить git-хуки метарепозитория"
set -euo pipefail

# Инструменты уже стоят, потому что mise run ставит недостающее из mise.toml
# перед задачей. Ключ --mise пишет в хук `mise x -- hk`, и хук берёт версии из
# mise.toml и mise.lock независимо от PATH git-клиента.
hk install --mise
