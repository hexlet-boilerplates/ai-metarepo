#!/usr/bin/env bash
#MISE description="Клонировать шаблоны hexlet-boilerplates в repos/ через ghorg"
set -euo pipefail
cd "$MISE_CONFIG_ROOT"

# Повторный запуск безопасен: GHORG_NO_CLEAN в .ghorg.conf.yaml запрещает
# git clean, и существующие клоны только подтягиваются.
GHORG_GITHUB_TOKEN="$(gh auth token)" \
	ghorg clone --config .ghorg.conf.yaml --path "$MISE_CONFIG_ROOT" hexlet-boilerplates
